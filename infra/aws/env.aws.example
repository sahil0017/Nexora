# NEXORA — AWS free-tier deploy configuration
# Copy this file to .env.aws (gitignored) and fill in the values.

# --- CloudFormation parameters ---
ENVIRONMENT_NAME=dev
# t3.micro (1 GB, free tier) or t3.small (2 GB, free-tier eligible, 2x credits)
INSTANCE_TYPE=t3.micro
# Your public IP for SSH, e.g. 1.2.3.4/32 — empty = SSH closed (deploys use SSM)
ADMIN_CIDR=
# Existing EC2 key pair (optional)
KEY_PAIR_NAME=

# --- Application config ---
AWS_REGION=ap-south-1
# Existing DynamoDB documents table (pk/sk, on-demand)
DDB_DOCS_TABLE=nexora-dev-documents
# RDS master credentials. Password: alphanumeric, 12+ chars -> openssl rand -hex 16
DB_USERNAME=nexora
DB_PASSWORD=CHANGE_ME
