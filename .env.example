# NEXORA local development environment
DB_PASSWORD=local_dev_password
MINIO_USER=nexora
MINIO_PASSWORD=local_minio_password
APP_ENV=development

# AWS (DynamoDB document backend — free tier, on-demand billing)
AWS_REGION=ap-south-1
DDB_DOCS_TABLE=nexora-dev-documents
# Credentials come from the standard AWS chain (env, ~/.aws/credentials, role):
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# Place search (Photon-compatible geocoder)
GEOCODER_URL=https://photon.komoot.io/api
