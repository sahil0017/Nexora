{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexora/transit.updated/v1",
  "title": "transit.updated.v1",
  "type": "object",
  "required": ["stop_id", "route_id", "delay_seconds", "observed_at"],
  "properties": {
    "stop_id": { "type": "string" },
    "route_id": { "type": "string" },
    "trip_id": { "type": "string" },
    "delay_seconds": { "type": "integer" },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
