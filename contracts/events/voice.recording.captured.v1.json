{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexora/voice.recording.captured/v1",
  "title": "voice.recording.captured.v1",
  "type": "object",
  "required": ["conversation_id", "recording_id", "user_id", "source_type", "sha256_original"],
  "properties": {
    "conversation_id": { "type": "string", "format": "uuid" },
    "recording_id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "source_type": { "enum": ["mobile_mic", "imported_file", "call", "meeting", "transcript_import"] },
    "consent_granted": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "sha256_original": { "type": "string" }
  }
}
